# The bridge is local-only by default. Do not expose it to your LAN or the internet.
# OpenClaw CLI must already be installed and your Gateway must be running.

# Port used by the dashboard bridge. Change only if this port is already taken.
OPENCLAW_DASHBOARD_PORT=18790

# Optional. Set this only when `openclaw` is not available in PATH.
# Windows example: OPENCLAW_COMMAND=C:\\Users\\simed\\AppData\\Roaming\\npm\\openclaw.cmd
# OPENCLAW_COMMAND=
